# dependencies - ignore at all levels
**/node_modules
/.pnp
.pnp.*

# testing
**/coverage

# next.js
**/.next/
**/out/

# production
**/build
**/dist

# misc
**/.DS_Store
*.pem

# debug
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
**/.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
**/next-env.d.ts

# turbo
.turbo
**/.turbo

# lock files (keep only root lock file)
apps/**/pnpm-lock.yaml
packages/**/pnpm-lock.yaml
apps/**/package-lock.json
packages/**/package-lock.json
