# dependencies - ignore at all levels
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage

# next.js
**/.next/
**/out/

# production
**/build
**/dist

# misc
**/.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
**/.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
**/next-env.d.ts

# claude
CLAUDE.md

# turbo
.turbo
**/.turbo

# lock files (keep only root lock file)
apps/**/pnpm-lock.yaml
packages/**/pnpm-lock.yaml
apps/**/package-lock.json
packages/**/package-lock.json
apps/**/yarn.lock
packages/**/yarn.lock